#!/usr/bin/env bash
set -euo pipefail

cd -- "$(git rev-parse --show-toplevel)"
scratch_dir=""
trap 'if [[ -n "$scratch_dir" ]]; then rm -rf -- "$scratch_dir"; fi' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Git supplies the exact revisions being pushed, which may differ from HEAD.
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ "$local_oid" =~ ^0+$ ]] && continue
    commit="$(git rev-parse --verify "$local_oid^{commit}")"
    if [[ -z "$scratch_dir" ]]; then
        scratch_dir="$(mktemp -d "${TMPDIR:-/tmp}/gosmb-pre-push.XXXXXXXX")"
    fi
    snapshot_dir="$scratch_dir/$commit"
    [[ -d "$snapshot_dir" ]] && continue
    mkdir -p -- "$snapshot_dir/source" "$snapshot_dir/built"

    # Building a snapshot keeps uncommitted changes out of pushed binaries.
    git archive "$commit" | tar -x -C "$snapshot_dir/source"
    printf 'Checking binaries for %s...\n' "$local_ref" >&2
    if ! bash "$snapshot_dir/source/build.sh" "$snapshot_dir/built" >&2; then
        printf 'Push blocked: build failed for %s.\n' "$local_ref" >&2
        exit 1
    fi

    stale=false
    shopt -s nullglob
    binaries=("$snapshot_dir/built"/*)
    if (( ${#binaries[@]} == 0 )); then
        printf 'Push blocked: build produced no binaries for %s.\n' "$local_ref" >&2
        exit 1
    fi
    for binary in "${binaries[@]}"; do
        path="builds/${binary##*/}"
        expected="$(git rev-parse --verify "$commit:$path" 2>/dev/null)" || expected=""
        if [[ "$(git hash-object --no-filters "$binary")" != "$expected" ]]; then
            printf 'Outdated or missing: %s\n' "$path" >&2
            stale=true
        fi
    done
    if "$stale"; then
        printf 'Push blocked: rebuild on %s with ./build.sh, commit builds/, then push again.\n' "$local_ref" >&2
        exit 1
    fi
done
